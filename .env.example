# Log level: trace, debug, info, warn, error, fatal
DEBUG_LEVEL=info

# Host ports the services are published on.
# Change these if another local devnet is already using the defaults.
MN_NODE_PORT=9944
MN_INDEXER_PORT=8088
MN_PROOF_SERVER_PORT=6300

# Endpoints the clients connect to. Keep these in step with the ports above.
MN_NODE_URL=http://127.0.0.1:9944
MN_NODE_WS=ws://127.0.0.1:9944
MN_INDEXER_URL=http://127.0.0.1:8088/api/v4/graphql
MN_INDEXER_WS=ws://127.0.0.1:8088/api/v4/graphql/ws
MN_PROOF_SERVER_URL=http://127.0.0.1:6300
