{
  "name": "midnight-local-network",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "docker rm -f midnight-node midnight-indexer midnight-proof-server 2>/dev/null; docker compose -f standalone.yml down --remove-orphans 2>/dev/null; true",
    "start": "node --experimental-specifier-resolution=node --loader ts-node/esm src/index.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/ledger-v8": "8.0.3",
    "@midnight-ntwrk/midnight-js-network-id": "4.0.2",
    "@midnight-ntwrk/wallet-sdk-abstractions": "2.0.0",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.0",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-facade": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.1",
    "@midnight-ntwrk/wallet-sdk-shielded": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "2.1.0",
    "@scure/bip39": "2.0.1",
    "dotenv": "17.2.3",
    "pino": "10.1.0",
    "pino-pretty": "13.1.3",
    "rxjs": "7.8.2",
    "testcontainers": "11.13.0",
    "ws": "8.20.1"
  },
  "devDependencies": {
    "@types/node": "25.0.1",
    "@types/ws": "8.18.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "resolutions": {
    "@midnight-ntwrk/ledger-v8": "8.0.3",
    "@midnight-ntwrk/midnight-js-network-id": "4.0.2"
  }
}
