{
  "name": "midnight-local-network",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "devnet:health": "bash scripts/assert-devnet-health.sh",
    "prestart": "node scripts/preflight.mjs",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "node -e \"const {globSync}=require('node:fs');const n=globSync('test/**/*.test.ts').length;if(!n){console.error('No test files matched test/**/*.test.ts');process.exit(1)}console.log(n+' test file(s)')\"",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "dotenv": "17.4.2",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "rxjs": "7.8.2",
    "testcontainers": "12.1.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/ws": "8.18.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
