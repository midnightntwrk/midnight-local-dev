{
  "name": "midnight-local-network",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "docker rm -f midnight-node midnight-indexer midnight-proof-server 2>/dev/null; docker compose -f standalone.yml down --remove-orphans 2>/dev/null; true",
    "start": "node --experimental-specifier-resolution=node --loader ts-node/esm src/index.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "dotenv": "17.2.3",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "rxjs": "7.8.2",
    "testcontainers": "12.1.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "25.9.2",
    "@types/ws": "8.18.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
